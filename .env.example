OPENROUTER_API_KEY=

# Free, no signup needed to use the API itself, but the ingestion pipeline needs a client id:
# https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Only needed for the opt-in "Generate with ElevenLabs" button — /suggestions works without
# it. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides — sane defaults are set in src/core/config.py
# VISION_MODEL=google/gemini-3.5-flash-lite
# AUDIO_MODEL=google/gemini-3.5-flash-lite
# TEXT_MODEL=google/gemini-3.5-flash-lite
# EBIND_MODEL_ID=encord-team/ebind-full
# DATABASE_URL=postgresql://mood_matcher:mood_matcher@localhost:5432/mood_matcher
# MUSIC_LENGTH_MS=30000
# MUSIC_TIMEOUT_SECONDS=60
